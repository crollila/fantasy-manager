{
  "name": "fantasy-manager-desktop",
  "productName": "Fantasy Manager",
  "version": "0.6.0",
  "description": "Local fantasy football lineups, injuries and draft intelligence",
  "author": "crollila",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "test": "node --test *.test.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.crollila.fantasymanager",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "connection.cjs",
      "espn-client.cjs",
      "espn-session.cjs",
      "package.json",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../build/backend/FantasyBackend",
        "to": "backend"
      },
      {
        "from": "../extension",
        "to": "extension",
        "filter": [
          "**/*",
          "!*.test.mjs"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Fantasy-Manager-Setup-${version}.${ext}"
    }
  }
}
