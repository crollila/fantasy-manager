# Copy to .env (never commit .env). All keys are optional; the system runs without them.

# The Odds API (https://the-odds-api.com) for live multi-book spreads/totals/moneylines.
# Without it, the app uses the nflverse schedule line snapshot as its market benchmark.
THE_ODDS_API_KEY=

# Where the application stores its SQLite database, caches and the NFL engine data.
# FANTASY_DATA_DIR=./storage
# NFL_DATA_DIR=./storage/nfl
